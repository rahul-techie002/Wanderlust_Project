<% layout("layouts/boilerplate.ejs") %>
    <style>
        #filters { display:flex; flex-wrap:wrap; gap:1rem; align-items:center; margin-bottom:1rem }
        .filter { text-align:center; opacity:.8; font-size:.9rem }
        .tax-info { display:none }
    </style>

    <div id="filters" class="mb-3">
        <div class="d-flex flex-wrap gap-3">
            <div class="filter"><div><i class="fa-solid fa-fire"></i></div><small>Trending</small></div>
            <div class="filter"><div><i class="fa-solid fa-bed"></i></div><small>Rooms</small></div>
            <div class="filter"><div><i class="fa-brands fa-fort-awesome"></i></div><small>Castles</small></div>
            <div class="filter"><div><i class="fa-solid fa-person-swimming"></i></div><small>Amazing pools</small></div>
            <div class="filter"><div><i class="fa-solid fa-campground"></i></div><small>Camping</small></div>
            <div class="filter"><div><i class="fa-solid fa-cow"></i></div><small>Farms</small></div>
            <div class="filter"><div><i class="fa-solid fa-snowflake"></i></div><small>Arctic</small></div>
        </div>

        <div class="ms-auto">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
                <label class="form-check-label" for="flexSwitchCheckDefault">Display taxes</label>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
        <% for(listing of allListings){ %>
            <div class="col">
                <a href="/listings/<%= listing.id %>" class="text-decoration-none text-dark">
                    <div class="card h-100">
                        <img src="<%=listing.image.url %>" class="card-img-top img-fluid" alt="listing_image" style="object-fit:cover; height:15rem">
                        <div class="card-body">
                            <h6 class="card-title mb-1"><%= listing.title %></h6>
                            <p class="card-text mb-0">&#8377;<%= listing.price.toLocaleString("en-IN") %>/Night <i class="tax-info">&nbsp;+18%GST</i></p>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>

    <script>
        let taxSwitch = document.getElementById("flexSwitchCheckDefault");
        if(taxSwitch){
            taxSwitch.addEventListener("click", () => {
                let taxInfo = document.getElementsByClassName("tax-info");
                for(let info of taxInfo){
                    info.style.display = (info.style.display !== "inline") ? "inline" : "none";
                }
            });
        }
    </script>